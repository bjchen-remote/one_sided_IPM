# Track maintained sources, documentation, tests and the original tau=0 fixture.
# Local experiments, frozen runtimes and AI tooling remain outside the repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/REPOSITORY.md
!/main.m
!/solver/
!/plotting/
!/time_evolution/
!/test/

/time_evolution/*
!/time_evolution/+ipm/
!/time_evolution/+ipm_c/
!/time_evolution/server/
!/time_evolution/tests/
!/time_evolution/tests_ipm_c/
!/time_evolution/*.m
!/time_evolution/*.md
!/time_evolution/run_*.py
!/time_evolution/TEST_FIXTURE_PROVENANCE.json

/test/*
!/test/+ipm_cr/
!/test/tests/
!/test/plots/
!/test/*.m
!/test/*.py
!/test/*.md
!/test/*.tex

# Generated output, local state and native build products.
**/runs/
**/results/
**/runtime/
**/checkpoints/
**/__pycache__/
**/.DS_Store
**/STOP
*.mat
*.mex*
*.o
*.obj
*.so
*.dylib
*.dll
*.py[cod]
*.asv
*.log
*.lock
*.pid
*.jsonl
*.writing
*.tmp
*.aux
*.toc
*.out
*.synctex.gz
*.pdf
*.png
*.jpg
*.fig
*.zip
*.tar.gz

# AI/agent scaffolding is not a solver dependency.
**/AGENTS.md
**/agent.m
**/agents.m
**/.agents/
**/.codex/
**/.claude/
**/skills/
.env
.env.*
*.pem
*.key

# One immutable numerical input is required by the default polar/mixed solvers.
# Preserve its historical path to keep source hashes and authority identity intact.
!/runs/
/runs/*
!/runs/local_validation_20261013/
/runs/local_validation_20261013/*
!/runs/local_validation_20261013/gaussian26_fresh_warm_01/
/runs/local_validation_20261013/gaussian26_fresh_warm_01/*
!/runs/local_validation_20261013/gaussian26_fresh_warm_01/data_frames/
/runs/local_validation_20261013/gaussian26_fresh_warm_01/data_frames/*
!/runs/local_validation_20261013/gaussian26_fresh_warm_01/data_frames/frame_step000000000000_tau0000000000000000.mat
