# Main contains the current ipm_cr solver. Old local work stays untracked.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/REPOSITORY.md
!/src/
!/tests/
!/tools/
!/examples/
!/docs/
!/data/
!/test/
/test/*
!/test/README.md
!/test/ALGORITHM_REPORT.tex

# Generated output and machine-specific native builds.
**/results/
**/runs/
**/runtime/
**/checkpoints/
**/__pycache__/
**/.DS_Store
**/STOP
*.mat
*.mex*
*.o
*.obj
*.so
*.dylib
*.dll
*.py[cod]
*.asv
*.log
*.lock
*.pid
*.jsonl
*.writing
*.tmp
*.aux
*.toc
*.out
*.synctex.gz
*.pdf
*.png
*.jpg
*.fig
*.zip
*.tar.gz

# Agent scaffolding and local credentials are not solver dependencies.
**/AGENTS.md
**/agent.m
**/agents.m
**/.agents/
**/.codex/
**/.claude/
**/skills/
.env
.env.*
*.pem
*.key

# One immutable input; its content SHA is recorded in data/initial.json.
!/data/reference/
!/data/reference/gaussian_t0.mat
