# One immutable numerical input is required by the default polar/mixed solvers.
# Preserve its historical path to keep source hashes and authority identity intact.
!/runs/
/runs/*
!/runs/local_validation_20261013/
/runs/local_validation_20261013/*
!/runs/local_validation_20261013/gaussian26_fresh_warm_01/
/runs/local_validation_20261013/gaussian26_fresh_warm_01/*
!/runs/local_validation_20261013/gaussian26_fresh_warm_01/data_frames/
/runs/local_validation_20261013/gaussian26_fresh_warm_01/data_frames/*
!/runs/local_validation_20261013/gaussian26_fresh_warm_01/data_frames/frame_step000000000000_tau0000000000000000.mat
